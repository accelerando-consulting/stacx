BOARD ?= espressif:esp32:esp32c3
ifeq ($(BOARD),espressif:esp32:esp32c3)
BOARD_OPTIONS ?= CDCOnBoot=cdc
endif


include ../../cli.mk
BASE_CPPFLAGS=-I../..


TFTPINS=-DTFT_SCLK=4 \
	-DTFT_MOSI=6 \
	-DTFT_CS=7 \
	-DTFT_DC=1 \
	-DTFT_RST=0 \
	-DTFT_BL=2 \
	-DTFT_BACKLIGHT_ON=HIGH

TFTFONTS=-DLOAD_GLCD=1 \
	-DLOAD_FONT2=1 \
	-DLOAD_FONT4=1 \
	-DLOAD_FONT6=1 \
	-DLOAD_FONT7=1 \
	-DLOAD_FONT8=1 \
	-DLOAD_GFXFF=1 \
	-DSMOOTH_FONT=1

CPPFLAGS=$(BASE_CPPFLAGS) \
	-DILI9341_2_DRIVER=1 \
	-DTFT_WIDTH=320 \
	-DTFT_HEIGHT=240 \
	-DTFT_INVERSION_OFF=1 \
	$(TFTPINS) \
	$(TFTFONTS) \
	-DSPI_FREQUENCY=65000000 \
	-DSPI_READ_FREQUENCY=20000000 \
	-DUSER_SETUP_LOADED=1
